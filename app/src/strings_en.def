/* dialogs */
X(S_DLG_CLASH_TITLE,       "Clashes with this Wi-Fi")
X(S_DLG_CLASH_TEXT,        "{0} sends {1} through the tunnel, but this Wi-Fi network uses the same addresses. Devices on it may stop answering.")
X(S_HELP_TITLE,            "Help")
X(S_HINT_HELP,             "Help")
X(S_HELP_BG_TITLE,         "Runs without this app")
X(S_HELP_BG_TEXT,          "Once connected, you can close this app and play. The tunnel keeps running in the background, in games too: closing the app never disconnects.")
X(S_HELP_SET_TITLE,        "Settings")
X(S_HELP_SET_TEXT,         "Settings \xE2\x80\xBA Network \xE2\x80\xBA VPN Settings \xE2\x80\xBA VPN Enabled switches the tunnel on or off with your last profile.")
X(S_HELP_QM_TITLE,         "Quick menu")
X(S_HELP_QM_TEXT,          "Hold the PS button for the VPN, status, profile and pause rows, even in a game. Needs QuickMenuReborn.")
X(S_HELP_FOOT,             "After a restart the tunnel starts off, with your last profile ready. If the Vita will not start, hold L while it starts to skip all plugins.")
X(S_HELP_LOCKDOWN,         "Lockdown (Details, START) lets only tunnel traffic out, even while disconnected and after a restart, and turns Pause off. Hold L while the Vita starts to start without it.")
X(S_DLG_DISC_TITLE,        "Disconnect?")
X(S_DLG_DISC_TEXT,         "Your traffic will go straight over Wi-Fi, outside the tunnel.")
X(S_DLG_DISC_TEXT_KS,      "The tunnel will close. With the kill switch on, the Vita stays offline until you connect again or turn the kill switch off.")
X(S_DLG_DISC_TEXT_LD,      "Lockdown stays on: the Vita will be offline until you connect again or turn Lockdown off.")
X(S_DLG_LD_TITLE,          "Turn on Lockdown?")
X(S_DLG_LD_TEXT,           "Only tunnel traffic can leave the Vita. Whenever the VPN is off it stays offline, after a restart too, and Pause is off. To undo it, turn it off here or in Settings \xE2\x80\xBA Network \xE2\x80\xBA VPN Settings, or hold L while the Vita starts.")
X(S_DLG_KEY_TITLE,         "Keys are stored in plain text")
X(S_DLG_KEY_TEXT,          "Each profile's private key sits unencrypted on the memory card. Anyone with the card can read it and use your VPN account.")

