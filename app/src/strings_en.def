/* about */
X(S_ABOUT_TITLE,           "About")
X(S_ABOUT_TAGLINE,         "A VPN client for the PS Vita. Bring your own profile.")
X(S_CLIENT_TITLE,          "Bring your own server")
X(S_CLIENT_NOTE,           "This is a VPN client, not a VPN service: it comes with no servers or accounts. You need a profile (.conf) from your own server or router, or from a VPN provider you use.")
